# ==============================================================================
# BẢO MẬT: TUYỆT ĐỐI KHÔNG ĐẨY CÁC FILE CHỨA PRIVATE KEY HOẶC THÔNG TIN MẬT LÊN GITHUB
# ==============================================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Các khóa bí mật, chứng chỉ
*.pem
*.key
*.p12

# ==============================================================================
# DEPENDENCIES (Thư viện cài đặt npm - Rất nặng, không cần đẩy lên)
# ==============================================================================
node_modules/
**/node_modules/

# ==============================================================================
# BUILD OUTPUTS & CACHES (File biên dịch tạm thời)
# ==============================================================================
# Hardhat (Smart contract)
smart-contract/artifacts/
smart-contract/cache/
.localappdata/

# Frontend (React / Vite)
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# EDITOR & HỆ ĐIỀU HÀNH
