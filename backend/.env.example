BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Địa chỉ Contract đã deploy (Nếu chưa chạy script deploy, có thể điền thủ công hoặc script deploy sẽ tự cập nhật vào contractData.json)
